# ─── Salesforce (client credentials OAuth) ───────────────────────────────────
# Same Connected App used by the Heroku app. Set the secret values locally;
# never commit this file with real values filled in.
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_INSTANCE_URL=https://storm-db63fb470328c9.my.salesforce.com
# Optional — defaults to SF_INSTANCE_URL. Client-credentials flow needs the My Domain URL.
SF_LOGIN_URL=

# ─── Agentforce agents (Einstein Agent API) ──────────────────────────────────
SF_AGENT_ID=0XxWt000000wiqHKAQ
SF_TRADE_AGENT_ID=0XxWt000000wkaLKAQ

# ─── Slack ───────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_WORKSPACE_URL=https://slack-demo-34143.enterprise.slack.com

# ─── Write guardrail ─────────────────────────────────────────────────────────
# Mutating tools (Slack posts / channel creation, work-order updates, record
# creation) are DISABLED unless this is exactly "true". Keep off for shared demo orgs.
ALLOW_WRITES=false
