<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>HAV Colo Operations</masterLabel>
    <description>Colo landing page: today's capacity, conflicts in the next 30 days, holds starting and ending soon, and open provision / move / decommission work orders, with actions.</description>
    <targets>
        <target>lightning__RecordPage</target>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Asset</object>
            </objects>
            <property name="horizonDays" type="Integer" default="21" label="Look-ahead (days)"/>
        </targetConfig>
        <targetConfig targets="lightning__AppPage,lightning__HomePage">
            <property name="horizonDays" type="Integer" default="21" label="Look-ahead (days)"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
