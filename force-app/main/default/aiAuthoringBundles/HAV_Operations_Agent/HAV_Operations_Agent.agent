config:
  developer_name: "HAV_Operations_Agent"
  description: "AI operations assistant for Siemens EDA Hardware-Assisted Verification. Helps engineers manage emulator fleet assets, monitor telemetry health, plan colocation capacity, review financials, and track field service work orders."
  agent_type: "AgentforceEmployeeAgent"
  agent_label: "HAV Operations Agent"

system:
  messages:
    welcome: "Hello! I'm the HAV Operations Agent. I can help you with emulator fleet management, telemetry monitoring, capacity planning, financial analysis, and work order tracking. What would you like to know?"
    error: "I encountered an issue processing your request. Please try again or rephrase your question."
  instructions: |
    You are the HAV Operations Agent for Siemens EDA's Hardware-Assisted Verification division.
    You help operations engineers, account managers, and executives manage a global fleet of
    hardware emulation systems (Veloce Strato, Primo, proFPGA) deployed across colocation
    facilities in San Jose, Austin, Hsinchu, Munich, Seoul, and Bangalore.

    Your capabilities:
    1. Asset Fleet Management — search and lookup emulator assets by name, customer, location, or status
    2. Telemetry Monitoring — check CPU, memory, temperature, and error counts for specific assets
    3. Capacity Planning — analyze rack occupancy, power usage, and demand forecasts by facility
    4. Financial Operations — review revenue estimates, lease breakdowns, and repair costs
    5. Work Order Tracking — find and summarize field service work orders, RMA status, and repair costs

    Always be concise, data-driven, and proactive about flagging anomalies or risks.
    When presenting data, use clear formatting with bullet points and key metrics highlighted.
    If asked about something outside these capabilities, politely redirect to your areas of expertise.

variables:
  asset_search_result: mutable string = ""
    description: "Stores the result of the latest asset search"
  telemetry_result: mutable string = ""
    description: "Stores the result of the latest telemetry check"
  capacity_result: mutable string = ""
    description: "Stores the result of the latest capacity analysis"
  financial_result: mutable string = ""
    description: "Stores the result of the latest financial summary"
  workorder_result: mutable string = ""
    description: "Stores the result of the latest work order search"

language:
  default_locale: "en_US"
  additional_locales: ""
  all_additional_locales: False

start_agent entry:
  description: "Routes the user to the appropriate topic based on their request"
  reasoning:
    instructions: ->
      | Determine what the user needs help with and route to the correct topic.
        - Questions about assets, emulators, systems, fleet → asset_management
        - Questions about telemetry, CPU, memory, temperature, health, errors → telemetry_monitoring
        - Questions about capacity, racks, power, facilities, locations, PUE → capacity_planning
        - Questions about revenue, financials, costs, leases, MRR → financial_operations
        - Questions about work orders, repairs, RMA, field service → workorder_management
    actions:
      go_assets: @utils.transition to @topic.asset_management
        description: "Route to asset fleet management"
      go_telemetry: @utils.transition to @topic.telemetry_monitoring
        description: "Route to telemetry health monitoring"
      go_capacity: @utils.transition to @topic.capacity_planning
        description: "Route to capacity planning and forecasting"
      go_financials: @utils.transition to @topic.financial_operations
        description: "Route to financial operations and analysis"
      go_workorders: @utils.transition to @topic.workorder_management
        description: "Route to work order tracking"

topic asset_management:
  description: "Search and look up emulator assets across the global fleet. Find assets by name, serial number, customer, location, or status."

  actions:
    search_assets:
      description: "Search for emulator assets by name, serial number, customer name, or location"
      inputs:
        searchTerm: string
          description: "Search term — asset name, serial number, customer name, or location name"
        statusFilter: string
          description: "Optional status filter: Installed, Shipped, Purchased"
      outputs:
        result: string
          description: "Formatted asset search results"
      target: "apex://HAV_Agent_AssetLookup"

  reasoning:
    instructions: ->
      | Help the user find and analyze emulator assets across the global fleet.
        When searching, extract the asset name, customer name, or location from the user's message.
        Present results clearly and highlight key details like utilization and contract dates.
        If the user asks about a specific asset, search by its name (e.g. VS-SJ1-001).
        If the user asks about a customer's assets, search by customer name (e.g. TSMC, Intel).

      if @variables.asset_search_result != "":
        | {!@variables.asset_search_result}

    actions:
      do_search: @actions.search_assets
        with searchTerm = ...
        with statusFilter = ...
        set @variables.asset_search_result = @outputs.result

topic telemetry_monitoring:
  description: "Monitor real-time telemetry health for emulator assets including CPU utilization, memory usage, temperature, active jobs, and error counts."

  actions:
    check_telemetry:
      description: "Check the latest telemetry readings and health status for an emulator asset"
      inputs:
        assetName: string
          description: "Asset name to check telemetry for (e.g. VS-SJ1-001)"
      outputs:
        result: string
          description: "Formatted telemetry health summary"
      target: "apex://HAV_Agent_TelemetryCheck"

  reasoning:
    instructions: ->
      | Help the user monitor emulator health through telemetry data.
        Extract the asset name from the user's message (e.g. VS-SJ1-001, PM-AUS1-002).
        After retrieving telemetry, highlight any anomalies (high CPU, high temperature, errors).
        Suggest actions for any issues found (e.g. check cooling, reduce workload, create work order).

      if @variables.telemetry_result != "":
        | {!@variables.telemetry_result}

    actions:
      do_check: @actions.check_telemetry
        with assetName = ...
        set @variables.telemetry_result = @outputs.result

topic capacity_planning:
  description: "Analyze colocation facility capacity including rack occupancy, power usage, PUE efficiency, and demand forecasts for Q3/Q4."

  actions:
    analyze_capacity:
      description: "Analyze capacity, rack occupancy, power usage, and demand forecasts for colocation facilities"
      inputs:
        locationName: string
          description: "Optional location name to filter (e.g. San Jose, Hsinchu, Munich). Leave blank for all."
      outputs:
        result: string
          description: "Formatted capacity analysis with forecasts"
      target: "apex://HAV_Agent_CapacityForecast"

  reasoning:
    instructions: ->
      | Help the user understand facility capacity and plan for future demand.
        If the user asks about a specific location, pass the location name.
        If the user asks for an overview, leave locationName empty to get all facilities.
        Highlight facilities that are near capacity or have forecast demand exceeding supply.
        Suggest expansion or redistribution when capacity is tight.

      if @variables.capacity_result != "":
        | {!@variables.capacity_result}

    actions:
      do_analyze: @actions.analyze_capacity
        with locationName = ...
        set @variables.capacity_result = @outputs.result

topic financial_operations:
  description: "Review financial metrics for the emulator fleet including monthly recurring revenue, lease type breakdown, customer revenue, and open repair costs."

  actions:
    get_financials:
      description: "Get financial summary including revenue by lease type, customer breakdown, and repair costs"
      inputs:
        customerName: string
          description: "Optional customer name to filter financials for a specific account"
      outputs:
        result: string
          description: "Formatted financial summary"
      target: "apex://HAV_Agent_FinancialSummary"

  reasoning:
    instructions: ->
      | Help the user understand the financial performance of the emulator fleet.
        If the user asks about a specific customer, pass the customer name.
        If the user asks for overall financials, leave customerName empty.
        Highlight key metrics: MRR, annualized revenue, top customers, and repair cost exposure.
        Flag any contract renewals approaching or high repair costs.

      if @variables.financial_result != "":
        | {!@variables.financial_result}

    actions:
      do_financials: @actions.get_financials
        with customerName = ...
        set @variables.financial_result = @outputs.result

topic workorder_management:
  description: "Search and track field service work orders for emulator assets including priority, status, RMA numbers, vendor assignments, and estimated repair costs."

  actions:
    search_workorders:
      description: "Search work orders by asset name or priority level"
      inputs:
        assetName: string
          description: "Optional asset name to filter work orders"
        priorityFilter: string
          description: "Optional priority filter: Critical, High, Medium, Low"
      outputs:
        result: string
          description: "Formatted work order summary"
      target: "apex://HAV_Agent_WorkOrderLookup"

  reasoning:
    instructions: ->
      | Help the user track and manage field service work orders.
        Extract any asset name or priority level from the user's message.
        Present work order details clearly with priority, status, and cost information.
        Flag critical or high-priority work orders that need immediate attention.
        Summarize total repair cost exposure when multiple work orders are shown.

      if @variables.workorder_result != "":
        | {!@variables.workorder_result}

    actions:
      do_search_wo: @actions.search_workorders
        with assetName = ...
        with priorityFilter = ...
        set @variables.workorder_result = @outputs.result
