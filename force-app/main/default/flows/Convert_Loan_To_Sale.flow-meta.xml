<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <description>Thin UI over HAV_LoanToSaleService. Launched from a Quick Action on the loan Order: calls the invocable conversion, then shows the resulting return order, sale order, and status message. All conversion logic lives in Apex; this flow is presentation only.</description>
    <environments>Default</environments>
    <interviewLabel>Convert Loan to Sale {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Convert Loan to Sale</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Confirm_Convert</targetReference>
        </connector>
    </start>
    <status>Active</status>

    <actionCalls>
        <name>Do_Convert</name>
        <label>Convert Loan Order to Sale</label>
        <locationX>176</locationX>
        <locationY>254</locationY>
        <actionName>HAV_LoanToSaleService</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Show_Result</targetReference>
        </connector>
        <inputParameters>
            <name>loanOrderId</name>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputParameters>
        <storeOutputAutomatically>false</storeOutputAutomatically>
        <nameSegment>HAV_LoanToSaleService</nameSegment>
        <outputParameters>
            <name>message</name>
            <assignToReference>resultMessage</assignToReference>
        </outputParameters>
    </actionCalls>

    <screens>
        <name>Confirm_Convert</name>
        <label>Confirm Conversion</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Do_Convert</targetReference>
        </connector>
        <fields>
            <name>Confirm_Message</name>
            <fieldText>&lt;p&gt;This will create a &lt;b&gt;Return order&lt;/b&gt; (green return) and a &lt;b&gt;Sale order&lt;/b&gt; from this loan order, re-associate the loaned asset(s) to the sale order, and publish SAP reconciliation events.&lt;/p&gt;&lt;p&gt;Continue?&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <nextOrFinishButtonLabel>Convert to Sale</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Show_Result</name>
        <label>Conversion Result</label>
        <locationX>176</locationX>
        <locationY>374</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Result_Message</name>
            <fieldText>&lt;p&gt;{!resultMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>

    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>resultMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
